# Скопируйте в .env и подставьте свои значения: cp .env.example .env
# Файл .env в git не попадает.

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAG...

# Ключ Claude с console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# Необязательное:
# BOT_SYSTEM_PROMPT=Ты — консультант магазина, отвечай коротко и вежливо.
# TELEGRAM_ALLOWED_CHATS=123456789          # отвечать только этим chat_id
# BOT_PROXY=http://user:pass@host:port      # если Telegram или API недоступны напрямую
# CLAUDE_MODEL=claude-opus-5
# CLAUDE_EFFORT=low                          # low | medium | high
# CLAUDE_MAX_TOKENS=2000
# BOT_HISTORY_LIMIT=40                       # сколько реплик помнить в чате
