# Пример секретов для Streamlit Cloud: Settings → Secrets → вставить содержимое.
# Локально скопируйте файл в .streamlit/secrets.toml (он не попадает в git).
# Все поля необязательные: без них приложение считает оценки по открытым данным.

# Прокси для доступа к WB, Ozon и Google Trends.
# proxy = "socks5://user:pass@host:1080"

# Точные данные вместо оценок.
# yandex_oauth = "AQAA..."
# xmlriver_user = "12345"
# xmlriver_key = "..."
# wb_token = "eyJhb..."
# ozon_client_id = "..."
# ozon_client_secret = "..."
