# Скопируйте в .env и заполните своими ключами. Файл .env в git не попадает.
# Ключи не нужно никому пересылать: код читает их из окружения на вашей машине.

# Seller API — личный кабинет продавца: Настройки → Seller API → Сгенерировать ключ.
OZON_CLIENT_ID=
OZON_API_KEY=

# Performance API — рекламный кабинет: Реклама → API-ключи (performance.ozon.ru).
OZON_PERF_CLIENT_ID=
OZON_PERF_CLIENT_SECRET=

# Предохранитель. Пока не 1 — любые изменения (ставки, поставки) блокируются.
OZON_ALLOW_WRITES=0
# Потолки на случай ошибки в расчётах: ставка выше и шаг больше не пройдут.
OZON_MAX_BID=500
OZON_MAX_BID_CHANGE_PCT=50
# OZON_MAX_DAILY_BUDGET=5000

# Если VPN на компьютере мешает запросам к Ozon — можно увести только их
# через свой прокси, не трогая остальную систему.
# OZON_PROXY=http://user:pass@host:port
